{
  "dashboard": {
    "title": "RAG System Metrics",
    "panels": [
      {
        "title": "Query Response Time",
        "targets": [
          {
            "expr": "rate(query_duration_seconds[5m])"
          }
        ],
        "type": "graph"
      },
      {
        "title": "Documents Processed",
        "targets": [
          {
            "expr": "documents_processed_total"
          }
        ],
        "type": "stat"
      },
      {
        "title": "Cache Hit Rate",
        "targets": [
          {
            "expr": "rate(cache_hits[5m]) / rate(cache_requests[5m])"
          }
        ],
        "type": "gauge"
      },
      {
        "title": "Active Sessions",
        "targets": [
          {
            "expr": "active_sessions"
          }
        ],
        "type": "stat"
      }
    ],
    "refresh": "30s",
    "schemaVersion": 27,
    "version": 1
  }
}